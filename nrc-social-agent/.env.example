# NRC Social Agent — environment variable template.
# Copy to .env and fill in real values locally. Never commit the real .env file.
# All values below are placeholders only — no real credentials.

# --- Telegram Bot API ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated Telegram numeric user IDs allowed to use the bot.
# Only these users can interact with it; everyone else gets a generic denial.
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id-here

# --- Claude API (Anthropic) ---
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional. Anthropic model ID used for media analysis.
# Default if unset: claude-opus-5 (see README.md for justification)
ANTHROPIC_MODEL=claude-opus-5

# Optional. Max tokens for a single analysis request. Default if unset: 4096
ANTHROPIC_MAX_TOKENS=4096

# Optional. Per-request timeout, in seconds. Default if unset: 60
ANTHROPIC_REQUEST_TIMEOUT_SECONDS=60

# Optional. Max automatic retries performed by the Anthropic SDK itself for
# safe transient failures (timeouts, connection errors, 429, 5xx). Default
# if unset: 2. No additional application-level retry loop is layered on top.
ANTHROPIC_MAX_RETRIES=2

# Optional. Schema version for persisted analysis documents. Default if
# unset: 1. Only change this when introducing a new, explicitly-supported
# analysis document schema.
ANALYSIS_SCHEMA_VERSION=1

# Optional. Safety cap on the adaptive clarification loop (Milestone 4B) —
# not a target question count, most uploads should need far fewer. Default
# if unset: 4. See README.md's "Maximum-question policy".
MAX_CLARIFICATION_QUESTIONS=4

# Optional. Safety ceiling on the number of outputs the Content Planning
# Engine (Milestone 5) may recommend in one plan — not a target count, a
# single strong output is a complete, valid plan. Default if unset: 3. See
# README.md's "Maximum-planned-outputs policy".
MAX_PLANNED_OUTPUTS=3

# Optional. Schema version for persisted content-plan documents. Default
# if unset: 1. Only change this alongside a corresponding
# ContentPlanDocument.from_dict() update.
CONTENT_PLAN_SCHEMA_VERSION=1

# Optional. Schema version for persisted draft documents (Milestone 6's
# Primary Draft Generation Engine). Default if unset: 1. Only change this
# alongside a corresponding DraftDocument.from_dict() update.
DRAFT_SCHEMA_VERSION=1

# Optional. Maximum Instagram Reel caption length, in characters — the
# target platform's real ceiling (Instagram's own caption limit), not
# Telegram's message limit. Default if unset: 2200. See README.md's
# "Length and platform constraints".
MAX_INSTAGRAM_CAPTION_LENGTH=2200

# Optional. Maximum number of hashtags a generated draft may include — a
# ceiling, not a target; zero hashtags is a valid, often-preferred draft.
# Default if unset: 5. See README.md's "Hashtag policy".
MAX_HASHTAGS=5

# Optional. Schema version for persisted publication packages (Milestone
# 8's Publication Preparation Layer). Default if unset: 1. Only change
# this alongside a corresponding PublicationPackage.from_dict() update.
PUBLICATION_SCHEMA_VERSION=1

# --- Instagram Publisher Adapter and Dispatch Lifecycle (Milestone 10) ---

# Optional. Default: false. Master feature flag — when false (the
# default), authoring, approval, publication preparation, and execution
# creation all work normally with zero Instagram configuration; only
# actually dispatching to Meta requires this explicitly set to true, and
# only then are INSTAGRAM_ACCOUNT_ID/META_ACCESS_TOKEN required. See
# README.md's "Feature flag / default-disabled behaviour".
#
# Milestone 11A's /instagram_status diagnostic command reads this same
# flag (and the credentials below, when set) but never requires them —
# it works, and reports cleanly, whether or not publishing is enabled.
# No new environment variable was introduced for diagnostics; see
# README.md's "Instagram Operational Diagnostics" section.
INSTAGRAM_PUBLISHING_ENABLED=false

# Required only when INSTAGRAM_PUBLISHING_ENABLED=true. The Meta Graph
# API version this client targets. Default if unset: v25.0 (verified
# current as of this milestone — see README.md/CLAUDE.md).
META_GRAPH_API_VERSION=v25.0

# Required only when INSTAGRAM_PUBLISHING_ENABLED=true. The Instagram
# professional (Business/Creator) account's numeric ID to publish to.
# NEVER a real value in this file.
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id-here

# Required only when INSTAGRAM_PUBLISHING_ENABLED=true. A long-lived
# Instagram User access token (Instagram Login for Business — see
# README.md's "Selected authentication model"). NEVER a real value in
# this file, never logged, never stored in S3, never returned to
# Telegram.
META_ACCESS_TOKEN=your-meta-access-token-here

# Optional. How long a temporary, presigned S3 URL granting Meta read
# access to one approved media asset stays valid. Conservative by design
# — comfortably covers container creation and status polling, far short
# of Meta's own 24-hour container-expiry ceiling. Default if unset: 1800
# (30 minutes).
INSTAGRAM_MEDIA_URL_TTL_SECONDS=1800

# Optional. Bounded container-status polling — interval between checks
# and the overall ceiling before a dispatch attempt is reported as a
# retryable timeout (never polled indefinitely). Defaults if unset: 5 and
# 120 seconds respectively (i.e. at most ~24 checks per attempt). The
# timeout must be greater than the interval.
INSTAGRAM_CONTAINER_POLL_INTERVAL_SECONDS=5
INSTAGRAM_CONTAINER_POLL_TIMEOUT_SECONDS=120

# Optional. How long a dispatch claim/lease is held before it's
# considered abandoned and eligible for expired-lease recovery. Default
# if unset: 300 (5 minutes).
DISPATCH_LEASE_SECONDS=300

# Optional. Per-request timeout for calls to the Meta Graph API, in
# seconds. Default if unset: 30.
META_REQUEST_TIMEOUT_SECONDS=30

# Optional. Default: empty (nobody authorized). Milestone 11B's
# /instagram_test_publish (controlled Instagram live validation) requires
# the calling Telegram user to be listed here, IN ADDITION TO the general
# TELEGRAM_ALLOWED_USER_IDS allowlist above — an ordinary authorized bot
# user is never automatically trusted to perform a real live publication.
# Never required at startup, even when INSTAGRAM_PUBLISHING_ENABLED=true;
# an empty/unset value simply means the command is unavailable to
# everyone until explicitly configured. Comma-separated Telegram numeric
# user IDs, same format as TELEGRAM_ALLOWED_USER_IDS. See
# docs/INSTAGRAM_LIVE_VALIDATION.md for the full operator runbook.
INSTAGRAM_LIVE_TEST_OPERATOR_IDS=

# --- Amazon S3 (storage + persistence) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_REGION=your-aws-region-here
S3_BUCKET_NAME=your-s3-bucket-name-here

# Optional. Prefix under which all media objects are stored in the bucket.
# Default if unset: media
S3_KEY_PREFIX=media

# Optional. Maximum accepted file size per media type, in megabytes. Both
# default to 20 — the standard Telegram Bot API's own ceiling for files a
# bot can download (see README.md). Only lower these; raising them above 20
# has no effect unless a local Bot API server is in use.
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=20

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=info
